---
const businessItems = [
  {
    title: "信息化解决方案",
    image: "/images/generated/business/home-business-solutions-v2.png",
    alt: "信息化解决方案会议现场",
    description:
      "面向金融、证券、电信、电力、政府与企业客户，提供需求调研、系统分析、方案设计与落地实施服务。",
  },
  {
    title: "系统集成与软件开发",
    image: "/images/generated/business/home-business-integration-v2.png",
    alt: "系统集成与软件开发交付现场",
    description:
      "承接大中型系统集成项目、实际应用系统建设、安全技术防范系统设计施工与信息技术咨询。",
  },
  {
    title: "设备销售与分销",
    image: "/images/generated/business/home-business-equipment-v2.png",
    alt: "软硬件设备展示与分销场景",
    description:
      "覆盖计算机软硬件及辅助设备、办公设备、电子产品、网络设备、安防设备、消防器材等产品供应。",
  },
  {
    title: "运维维护与租赁",
    image: "/images/generated/business/home-business-maintenance-v2.png",
    alt: "运维维护与网络设备巡检现场",
    description:
      "提供计算机及办公设备维修、通用设备修理、电子机械设备维护、设备租赁与长期服务支持。",
  },
];

const industries = ["金融", "证券", "电信", "电力", "政府信息化", "中小企业", "大型企业", "个人用户"];

const serviceSteps = [
  "围绕客户业务现场完成需求梳理",
  "结合预算、场景与安全要求制定方案",
  "组织软硬件供应、集成实施与交付验收",
  "提供持续维护、响应支持与升级建议",
];

const galleryItems = [
  {
    title: "方案评审",
    image: "/images/generated/business/home-hero-solution-workshop-v2.png",
    alt: "客户方案评审会议",
  },
  {
    title: "集成调试",
    image: "/images/generated/business/integration-03.png",
    alt: "工程师进行系统集成调试",
  },
  {
    title: "设备交付",
    image: "/images/generated/business/home-gallery-equipment-v2.png",
    alt: "设备库存检查与交付准备",
  },
  {
    title: "现场维护",
    image: "/images/generated/business/home-gallery-maintenance-v2.png",
    alt: "运维人员检查租赁设备",
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="长春市奕多经贸有限公司是一家立足长春的信息化解决方案服务商，提供系统集成、软件开发、软硬件设备供应、运维维护与信息技术咨询服务。"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>长春市奕多经贸有限公司｜信息化解决方案与系统集成服务</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="长春市奕多经贸有限公司首页">
        <img
          class="brand-logo"
          src="/brand/yiduo-logo.png?v=transparent-1"
          alt="奕多经贸 YIDUO JINGMAO"
          width="816"
          height="197"
        />
      </a>
      <nav class="nav" aria-label="主导航">
        <a href="#about">公司简介</a>
        <a href="#business">主营业务</a>
        <a href="#industries">服务领域</a>
        <a href="#contact">联系方式</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">成立于 2015 · 长春本地信息化服务商</p>
          <h1 id="hero-title">让企业信息化建设更稳、更准、更高效</h1>
          <p class="hero-lead">
            长春市奕多经贸有限公司专注计算机信息化解决方案，围绕系统集成、软硬件供应、软件开发与运维服务，为政府、金融、电信、电力及企业客户提供可靠交付。
          </p>
          <div class="hero-actions" aria-label="页面快捷操作">
            <a class="button primary" href="#business">了解主营业务</a>
            <a class="button secondary" href="#contact">联系奕多</a>
          </div>
        </div>
        <div class="hero-visual" aria-label="信息化服务项目现场">
          <img
            class="hero-photo"
            src="/images/generated/business/home-hero-solution-workshop-v2.png"
            alt="奕多经贸信息化解决方案项目讨论现场"
            width="1200"
            height="675"
          />
          <div class="visual-panel panel-main">
            <span class="panel-kicker">Project Scene</span>
            <strong>从方案到交付</strong>
            <p>需求梳理 · 系统集成 · 设备供应 · 运维支持</p>
          </div>
          <div class="visual-panel panel-side">
            <span class="status-dot"></span>
            <strong>7x24</strong>
            <p>持续服务支持</p>
          </div>
          <div class="visual-panel panel-list">
            <span>政府信息化</span>
            <span>金融证券</span>
            <span>电力电信</span>
            <span>企业办公</span>
          </div>
        </div>
      </section>

      <section id="about" class="section about-section" aria-labelledby="about-title">
        <div class="section-label">About Yiduo</div>
        <div class="section-grid">
          <div>
            <h2 id="about-title">立足长春，服务真实业务现场的信息化伙伴</h2>
          </div>
          <div class="rich-copy">
            <p>
              长春市奕多经贸有限公司成立于 2015 年 7 月 29 日，是一家提供计算机信息化解决方案的专业公司。公司长期围绕国民经济信息化项目建设，为客户提供系统分析、系统集成、应用系统建设、软硬件设备供应与后续维护服务。
            </p>
            <p>
              在多年计算机销售和服务过程中，奕多经贸形成了“以市场为中心，以客户需求为导向”的经营宗旨。公司持续追踪计算机及信息技术领域的新产品、新方案，并结合客户的具体业务场景，提供务实、高效、可持续的服务。
            </p>
          </div>
        </div>
        <div class="proof-strip" aria-label="公司关键事实">
          <div>
            <strong>2015</strong>
            <span>公司成立</span>
          </div>
          <div>
            <strong>500 万</strong>
            <span>注册资本</span>
          </div>
          <div>
            <strong>多行业</strong>
            <span>项目经验</span>
          </div>
          <div>
            <strong>全链路</strong>
            <span>销售、集成、维护</span>
          </div>
        </div>
      </section>

      <section id="business" class="section business-section" aria-labelledby="business-title">
        <div class="section-heading">
          <span class="section-label">Core Business</span>
          <h2 id="business-title">主营业务</h2>
          <p>
            从前期方案到项目交付，再到长期维护，奕多经贸为不同规模客户提供完整的信息化产品与服务组合。
          </p>
        </div>
        <div class="business-grid">
          {
            businessItems.map((item, index) => (
              <article class="business-card">
                <img src={item.image} alt={item.alt} width="1200" height="675" loading="lazy" />
                <div class="business-card-body">
                  <span class="card-number">{String(index + 1).padStart(2, "0")}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section gallery-section" aria-labelledby="gallery-title">
        <div class="section-heading">
          <span class="section-label">Project Scenes</span>
          <h2 id="gallery-title">把服务落到看得见的现场</h2>
          <p>
            从方案沟通、集成调试到设备交付和后续维护，奕多经贸关注项目全流程的稳定推进。
          </p>
        </div>
        <div class="gallery-grid">
          {
            galleryItems.map((item) => (
              <figure class="gallery-item">
                <img src={item.image} alt={item.alt} width="1200" height="675" loading="lazy" />
                <figcaption>{item.title}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section id="industries" class="section split-section" aria-labelledby="industries-title">
        <div class="industry-copy">
          <span class="section-label">Industries</span>
          <h2 id="industries-title">覆盖个人、中小企业与大型组织的完整服务线</h2>
          <p>
            奕多经贸按照目标客户类型建立产品与服务体系，既能满足个人与中小企业的办公设备、软硬件采购和维护需求，也能服务大企业及政企客户的信息化建设、系统集成与安全应用场景。
          </p>
          <div class="tag-cloud" aria-label="服务行业">
            {industries.map((item) => <span>{item}</span>)}
          </div>
        </div>
        <div class="process" aria-label="服务流程">
          {serviceSteps.map((step, index) => (
            <div class="process-row">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{step}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section promise-section" aria-labelledby="promise-title">
        <div>
          <span class="section-label">Service Promise</span>
          <h2 id="promise-title">以客户需求为导向，把方案做实，把服务做长</h2>
        </div>
        <p>
          我们关注的不是单次设备交付，而是客户业务能否稳定运行。奕多经贸在系统分析、设备选型、集成实施、维护响应中坚持清晰沟通与可靠执行，帮助客户降低建设成本、缩短实施周期、提升信息化系统的可用性。
        </p>
      </section>

      <section id="contact" class="contact-section" aria-labelledby="contact-title">
        <div class="contact-copy">
          <span class="section-label">Contact</span>
          <h2 id="contact-title">期待与您沟通信息化建设需求</h2>
          <p>
            如果您正在规划系统集成、办公设备采购、安防网络建设、软件开发或长期运维服务，可以通过以下方式联系奕多经贸。
          </p>
        </div>
        <address class="contact-list">
          <a href="tel:13756513180">
            <span>联系人</span>
            <strong>程基帅 13756513180</strong>
          </a>
          <a href="mailto:990289424@qq.com">
            <span>邮箱</span>
            <strong>990289424@qq.com</strong>
          </a>
          <p>
            <span>地址</span>
            <strong>吉林省长春市朝阳区工农大路1313号百脑汇科技大厦1411-1室</strong>
          </p>
        </address>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #15201c;
    --muted: #596861;
    --paper: #fbfcf8;
    --accent: #0f6f63;
    --accent-2: #1d5ed8;
    --line: rgba(21, 32, 28, 0.12);
    --shadow: 0 22px 70px rgba(23, 47, 39, 0.13);
    font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      linear-gradient(90deg, rgba(15, 111, 99, 0.045) 1px, transparent 1px) 0 0 / 88px 88px,
      linear-gradient(180deg, #f8fbf6 0%, #fbfcf8 38%, #eef5ef 100%);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 76px;
    padding: 16px clamp(20px, 5vw, 72px);
    border-bottom: 1px solid rgba(21, 32, 28, 0.1);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    min-width: 230px;
  }

  .brand-logo {
    display: block;
    width: clamp(188px, 18vw, 236px);
    height: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 34px);
    color: #334139;
    font-size: 14px;
    font-weight: 600;
  }

  .nav a {
    transition: color 180ms ease;
  }

  .nav a:hover {
    color: var(--accent);
  }

  main {
    overflow: hidden;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.98fr);
    gap: clamp(36px, 6vw, 92px);
    align-items: center;
    min-height: calc(100svh - 76px);
    padding: clamp(54px, 8vw, 108px) clamp(20px, 5vw, 72px) clamp(58px, 8vw, 96px);
  }

  .eyebrow,
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .eyebrow::before,
  .section-label::before {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1 {
    max-width: 790px;
    font-size: clamp(42px, 5.4vw, 72px);
    line-height: 1.04;
    font-weight: 850;
    letter-spacing: 0;
  }

  .hero-lead {
    max-width: 690px;
    margin-top: 26px;
    color: var(--muted);
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 800;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.primary {
    background: var(--accent);
    color: #f7fbf6;
    box-shadow: 0 14px 36px rgba(15, 111, 99, 0.24);
  }

  .button.secondary {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.56);
  }

  .hero-visual {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(128px, 0.42fr);
    grid-template-rows: auto auto;
    align-content: flex-end;
    align-items: flex-end;
    gap: clamp(12px, 1.6vw, 20px);
    aspect-ratio: 5 / 4;
    min-height: clamp(360px, 36vw, 460px);
    padding: clamp(20px, 3vw, 42px);
    border-radius: 18px;
    overflow: hidden;
    background: #172a24;
    box-shadow: var(--shadow);
    isolation: isolate;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    inset: clamp(14px, 2.4vw, 24px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    z-index: 2;
    pointer-events: none;
  }

  .hero-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(10, 24, 20, 0.08), rgba(10, 24, 20, 0.42)),
      linear-gradient(90deg, rgba(15, 111, 99, 0.2), rgba(29, 94, 216, 0.18));
    pointer-events: none;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual-panel {
    position: relative;
    z-index: 3;
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    background: rgba(250, 254, 248, 0.44);
    color: var(--ink);
    box-shadow: 0 14px 30px rgba(10, 33, 28, 0.12);
    word-break: keep-all;
    backdrop-filter: blur(16px) saturate(1.08);
  }

  .panel-main {
    grid-column: 1 / -1;
    justify-self: end;
    width: min(100%, 462px);
    padding: clamp(18px, 2.4vw, 28px);
  }

  .panel-kicker {
    display: block;
    color: var(--accent-2);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .panel-main strong {
    display: block;
    margin-top: 12px;
    font-size: clamp(27px, 3.4vw, 43px);
    line-height: 1.05;
  }

  .panel-main p,
  .panel-side p {
    margin-top: 12px;
    color: var(--muted);
    line-height: 1.7;
  }

  .signal-lines {
    display: grid;
    gap: 10px;
    margin-top: 34px;
  }

  .signal-lines span {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(15, 111, 99, 0.28), rgba(29, 94, 216, 0.14));
  }

  .signal-lines span:nth-child(2) {
    width: 74%;
  }

  .signal-lines span:nth-child(3) {
    width: 48%;
  }

  .panel-side {
    grid-column: 2;
    grid-row: 2;
    align-self: stretch;
    padding: clamp(18px, 2.2vw, 24px);
  }

  .panel-side strong {
    display: block;
    margin-top: 18px;
    font-size: clamp(34px, 4vw, 42px);
    line-height: 1;
    white-space: nowrap;
  }

  .status-dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #26b476;
    box-shadow: 0 0 0 8px rgba(38, 180, 118, 0.15);
  }

  .panel-list {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    gap: 10px;
    align-content: center;
    padding: clamp(16px, 2vw, 20px);
  }

  .panel-list span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #334139;
    font-size: 14px;
    font-weight: 800;
  }

  .panel-list span::after {
    content: "";
    width: 36px;
    height: 2px;
    background: color-mix(in srgb, var(--accent) 42%, transparent);
  }

  .section {
    padding: clamp(72px, 10vw, 132px) clamp(20px, 5vw, 72px);
  }

  .section-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.78fr) minmax(320px, 1.22fr);
    gap: clamp(36px, 7vw, 110px);
    align-items: start;
  }

  h2 {
    max-width: 780px;
    font-size: clamp(32px, 4.8vw, 62px);
    line-height: 1.12;
    font-weight: 850;
    letter-spacing: 0;
  }

  .rich-copy {
    display: grid;
    gap: 18px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.95;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(44px, 7vw, 76px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .proof-strip div {
    min-height: 132px;
    padding: 26px 24px;
    border-right: 1px solid var(--line);
  }

  .proof-strip div:last-child {
    border-right: 0;
  }

  .proof-strip strong {
    display: block;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1;
  }

  .proof-strip span {
    display: block;
    margin-top: 14px;
    color: var(--muted);
    font-weight: 700;
  }

  .business-section {
    background: #f2f7f1;
  }

  .section-heading {
    max-width: 760px;
  }

  .section-heading p,
  .industry-copy p,
  .promise-section p,
  .contact-copy p {
    margin-top: 18px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.9;
  }

  .business-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 48px;
  }

  .business-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, #f8fbf6 90%, white);
  }

  .business-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
